// Те же проверки, но внутри одноразовой ВМ Debian 13 (этап 7): работает ли скрипт не только на Gentoo.
// Задача «Pipeline script from SCM», Script Path = Jenkinsfile.vm. Инфраструктура ВМ — /srv/virt на хосте агента.
pipeline {
    agent { label 'kvm' }
    parameters {
        choice(name: 'VM', choices: ['debian-13'], description: 'Машина из /srv/virt/vms.conf')
    }
    options {
        // SSH-порт машины фиксированный — одновременно может жить только одна машина каждого типа
        lock(resource: "vm-${params.VM ?: 'debian-13'}")
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    environment {
        VIRT  = '/srv/virt'
        VM    = "${params.VM ?: 'debian-13'}"
        VM_ID = "jenkins-${env.BUILD_NUMBER}"
    }
    stages {
        stage('ВМ: запуск') {
            steps {
                sh '"$VIRT/bin/vm-up" "$VM" "$VM_ID"'
                sh '"$VIRT/bin/vm-ssh" "$VM" "uname -a; grep PRETTY_NAME /etc/os-release; bats --version"'
            }
        }
        stage('ВМ: копирование') {
            steps {
                sh '"$VIRT/bin/vm-ssh" "$VM" --scp bin vm:bin'
                sh '"$VIRT/bin/vm-ssh" "$VM" --scp test vm:test'
            }
        }
        stage('ВМ: shellcheck') {
            steps {
                sh '"$VIRT/bin/vm-ssh" "$VM" "shellcheck bin/*.sh"'
            }
        }
        stage('ВМ: тесты') {
            steps {
                sh script: '"$VIRT/bin/vm-ssh" "$VM" "mkdir -p reports && bats --print-output-on-failure --report-formatter junit --output reports test/"',
                   returnStatus: true
            }
            post {
                always {
                    sh 'rm -rf reports && mkdir reports && "$VIRT/bin/vm-ssh" "$VM" --scp vm:reports/report.xml "reports/$VM.xml"'
                    junit "reports/*.xml"
                }
            }
        }
    }
    post {
        // машину гасим при любом исходе — иначе она займёт порт и память до перезагрузки хоста
        always { sh '"$VIRT/bin/vm-down" "$VM" "$VM_ID"' }
    }
}
